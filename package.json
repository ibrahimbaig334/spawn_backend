{
  "name": "spawn-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API, chain indexer, and outbox worker for the Spawn launchpad",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nest build && tsc -p tsconfig.worker.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "worker:dev": "yarn build && node --env-file-if-exists=.env dist/worker.js",
    "start:indexer": "node --env-file-if-exists=.env dist/indexer.js",
    "indexer:dev": "yarn build && node --env-file-if-exists=.env dist/indexer.js",
    "start:broadcaster": "node --env-file-if-exists=.env dist/broadcaster.js",
    "broadcaster:dev": "yarn build && node --env-file-if-exists=.env dist/broadcaster.js",
    "manifest:sync": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs scripts/manifest-sync.ts",
    "format": "prettier --write \"{src,prisma,test,scripts}/**/*.{ts,js,json}\" \"*.{json,md,yml,yaml,mjs}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"{src,prisma,test,scripts}/**/*.{ts,js,json}\" \"*.{json,md,yml,yaml,mjs}\" --ignore-path .prettierignore",
    "lint": "eslint \"{src,prisma,test,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "openapi:generate": "yarn build && node dist/openapi.js",
    "openapi:check": "yarn build && node dist/openapi.js --check"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "fastify": "5.11.3",
    "ioredis": "6.0.0",
    "json-canonicalize": "3.0.0",
    "multiformats": "14.0.5",
    "nestjs-pino": "5.1.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "thirdweb": "5.121.2",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
