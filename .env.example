# Node environment: development | test | production
NODE_ENV=development
# Process role: api | worker | indexer | broadcaster | seed
PROCESS_ROLE=api
PORT=3000

# PostgreSQL (role-separated URLs; DATABASE_URL is the API role)
DATABASE_URL=postgresql://spawn_api:spawn@localhost:5432/spawn?schema=public
SEED_DATABASE_URL=postgresql://spawn_seed:spawn@localhost:5432/spawn?schema=public
MIGRATION_DATABASE_URL=postgresql://spawn_migration:spawn@localhost:5432/spawn?schema=public
INDEXER_DATABASE_URL=postgresql://spawn_indexer:spawn@localhost:5432/spawn?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# HTTP
CORS_ORIGINS=http://localhost:3001
TRUSTED_PROXY=
LOG_LEVEL=info
RATE_LIMIT_HMAC_KEY=change-me-at-least-32-characters-long

# Chain / protocol
DEFAULT_CHAIN_ID=8453
# Comma-separated RPC endpoints (first is primary). Required for the indexer and
# for any live chain reads (quotes, slot0, keepers).
CHAIN_RPC_URLS=https://mainnet.base.org
# Optional per-address overrides that win over the stored deployment manifest.
# Leave empty pre-deployment; the manifest:sync script stores the real addresses.
SPAWN_HOOK_ADDRESS=
SPAWN_LAUNCH_SUPPORT_ADDRESS=
SPAWN_REVENUE_NFT_ADDRESS=
SPAWN_REGISTRY_ADDRESS=
SPAWN_CONTROLLER_ADDRESS=
POOL_MANAGER_ADDRESS=
STATE_VIEW_ADDRESS=
V4_QUOTER_ADDRESS=
MULTICALL3_ADDRESS=

# Indexer
# First block to scan (set to the protocol deployment block once known).
INDEXER_START_BLOCK=
INDEXER_CONFIRMATION_BLOCKS=32
INDEXER_BLOCK_BATCH=50
INDEXER_POLL_MS=3000
INDEXER_MAX_REORG_DEPTH=256

# Trusted operator key for relayed launches (BACKEND_GUIDE 6.1). Production: HSM/Vault.
# The on-chain trustedOperator must equal this key's address.
TRUSTED_OPERATOR_PRIVATE_KEY=

# WS broadcaster port (pg LISTEN -> /ws tick/bar streams)
BROADCASTER_WS_PORT=3001

# Thirdweb storage (token metadata uploads)
THIRDWEB_SECRET_KEY=

# Seed guards
ALLOW_DESTRUCTIVE_SEED=false
SEED_REFERENCE_TIME=
