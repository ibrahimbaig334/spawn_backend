    "/api/v1/launch/records": {
      "get": {
        "operationId": "listLaunchRecords",
        "parameters": [
          {
            "name": "creator",
            "required": false,
            "in": "query",
            "description": "Filter by creator wallet",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING_SIGNATURE",
                "SUBMITTED",
                "CONFIRMED",
                "REORGED",
                "FAILED"
              ]
            }
          },
          {
            "name": "chainId",
            "required": false,
            "in": "query",
            "description": "Chain id",
            "schema": {
              "default": 8453,
              "type": "number"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page",
            "schema": {
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Limit",
            "schema": {
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "",
        "tags": [
