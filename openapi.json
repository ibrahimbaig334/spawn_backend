  "info": {
    "title": "Spawn API",
    "description": "Offchain launchpad API merged with committed onchain projections",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateTokenDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {}
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {}
      },
      "TokenSocialsDto": {
        "type": "object",
        "properties": {
          "website": {
            "type": "string",
            "description": "HTTPS website URL",
            "example": "https://example.com"
          },
          "x": {
            "type": "string",
            "description": "HTTPS X/Twitter URL"
          },
          "telegram": {
            "type": "string",
            "description": "HTTPS telegram URL"
          },
          "discord": {
            "type": "string",
            "description": "HTTPS discord URL"
          }
        }
      },
      "PrepareLaunchDto": {
        "type": "object",
        "properties": {
          "creatorWalletAddress": {
            "type": "string",
            "description": "Declared creator; must equal the EIP-712 signer.",
            "example": "0x…"
          },
          "name": {
            "type": "string",
            "description": "Token name",
            "maxLength": 80
          },
          "symbol": {
            "type": "string",
            "description": "Token symbol",
            "example": "SPWN",
            "maxLength": 12
          },
          "description": {
            "type": "string",
            "description": "Token description",
            "maxLength": 8000
          },
          "imageUri": {
            "type": "string",
            "description": "ipfs:// image URI (CIDv1)"
          },
          "socials": {
            "$ref": "#/components/schemas/TokenSocialsDto"
          },
          "totalSupply": {
            "type": "string",
            "description": "Total supply in token-wei; pinned by protocol to 1,000,000,000e18"
          },
          "devBuyShareWad": {
            "type": "string",
            "description": "Dev-buy share in WAD units (decimal string); hard cap 0.1e18"
          },
          "payoutPlan": {
            "type": "string",
            "description": "Payout plan bitset (decimal string); bit i selects registry index i"
          },
          "deadline": {
            "type": "number",
            "description": "Signature deadline (unix seconds)"
          }
        },
        "required": [
          "creatorWalletAddress",
          "name",
          "symbol",
          "description",
          "imageUri",
          "totalSupply",
          "devBuyShareWad",
          "payoutPlan",
          "deadline"
        ]
      },
      "RelayLaunchDto": {
        "type": "object",
        "properties": {
          "launchId": {
            "type": "string",
            "description": "UUID of the prepared launch record"
          }
        },
        "required": [
          "launchId"
        ]
      }
    }
  }
}
