generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OnchainPhase {
  NONE
  BONDING_CURVE
  GRADUATED
}

enum Timeframe {
  H1
  H24
  D7
  D30
  ALL
}

enum TradeSide {
  BUY
  SELL
}

enum CandleInterval {
  M1
  M5
  M15
  H1
  H4
  D1
}

enum MilestoneKind {
  CORE
  EXTENSION
}

enum MilestoneState {
  PENDING
  DEPLOYED
  SKIPPED
  HARVESTED
}

enum AccrualSource {
  CURVE_PROCEEDS
  SWAP_FEES
  MILESTONE_HARVEST
}

enum PayoutOutcome {
  DELIVERED
  CARRIED
  REDIRECTED
}

enum GovernanceAction {
  SET_ECONOMIC_CONFIG
  SET_PROTOCOL_RECIPIENT
  REGISTER_PLUGIN
  SET_PLUGIN_SUSPENDED
  SET_GOVERNANCE_DELAY
}

enum GovernanceStatus {
  SCHEDULED
  CANCELLED
  EXECUTED
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum LaunchMode {
  CREATOR_DIRECT
  RELAYED
}

enum LaunchRecordState {
  PENDING_SIGNATURE
  SUBMITTED
  CONFIRMED
  REORGED
  FAILED
}

// ---------------------------------------------------------------------------
// Offchain domain (API-owned)
// ---------------------------------------------------------------------------

model Profile {
  walletAddress  String        @id @db.VarChar(42)
  username       String?       @unique @db.VarChar(32)
  usernameFolded String?       @unique @db.VarChar(32)
  bio            String?       @db.VarChar(1200)
  imageUri       String?       @db.VarChar(512)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  tokens         Token[]
  comments       Comment[]
  commentLikes   CommentLike[]

  @@map("profiles")
}

model Token {
  id                   String               @id @default(uuid()) @db.Uuid
  chainId              Int
  claimedCreatorWallet  String               @db.VarChar(42)
  name                 String               @db.VarChar(320)
  symbol               String               @db.VarChar(12)
  description          String               @db.VarChar(8000)
  imageUri             String               @db.VarChar(512)
  ipfsUri              String               @db.VarChar(512)
  gatewayUrl           String               @db.VarChar(2048)
  socials              Json?
  configHash           String?              @db.VarChar(66)
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)
  creator              Profile              @relation(fields: [claimedCreatorWallet], references: [walletAddress])
  projection           TokenChainState?
  metrics              TokenMetric[]
  trades               Trade[]
  candles              Candle[]
  milestones           Milestone[]
  holdings             Holding[]
  revenueEvents        RevenueEvent[]
  comments             Comment[]
  launchRecord         LaunchRecord?

  @@unique([chainId, configHash])
  @@index([claimedCreatorWallet, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("tokens")
}

model LaunchRecord {
  id                   String            @id @default(uuid()) @db.Uuid
  chainId              Int
  creatorWallet        String            @db.VarChar(42)
  name                 String            @db.VarChar(320)
  symbol               String            @db.VarChar(12)
  totalSupply          Decimal           @db.Decimal(78, 0)
  devBuyShareWad       Decimal           @db.Decimal(38, 18)
  payoutPlan           Decimal           @db.Decimal(78, 0)
  deadline             BigInt
  configHash           String            @db.VarChar(66)
  predictedToken       String            @db.VarChar(42)
  signature            String?
  digest               String            @db.VarChar(66)
  mode                 LaunchMode
  state                LaunchRecordState @default(PENDING_SIGNATURE)
  transactionHash      String?           @db.VarChar(66)
  submittedAt          DateTime?         @db.Timestamptz(6)
  confirmedAt          DateTime?         @db.Timestamptz(6)
  blockNumber          BigInt?
  failureReason       String?           @db.VarChar(1000)
  tokenId              String?           @unique @db.Uuid
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)
  token                Token?            @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@unique([chainId, configHash, creatorWallet])
  @@index([creatorWallet, state])
  @@index([state, createdAt])
  @@map("launch_records")
}

model IdempotencyRequest {
  id             String           @id @default(uuid()) @db.Uuid
  scope          String           @db.VarChar(128)
  walletAddress  String           @db.VarChar(42)
  key            String           @db.VarChar(128)
  requestHash    String           @db.VarChar(66)
  state          IdempotencyState @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  resourceId     String?          @db.Uuid
  expiresAt      DateTime         @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([scope, walletAddress, key])
  @@index([expiresAt])
  @@map("idempotency_requests")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  topic          String    @db.VarChar(128)
  aggregateId    String    @db.VarChar(128)
  attemptVersion Int?
  payload        Json
  availableAt    DateTime  @default(now()) @db.Timestamptz(6)
  leaseOwner     String?   @db.VarChar(128)
  leaseExpiresAt DateTime? @db.Timestamptz(6)
  publishedAt    DateTime? @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

model DomainGeneration {
  domain     String   @id @db.VarChar(128)
  generation BigInt   @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@map("domain_generations")
}

// ---------------------------------------------------------------------------
// Indexer ledger: blocks, manifests, raw event log
// ---------------------------------------------------------------------------

model DeploymentManifest {
  chainId   Int      @id
  document  Json
  syncedAt  DateTime @updatedAt @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("deployment_manifests")
}

model ChainCursor {
  chainId          Int      @id
  // Lowest unprocessed block height (exclusive): ingest blocks >= this.
  nextBlock        BigInt
  // Head block already ingested (inclusive).
  headBlock        BigInt
  headBlockHash    String   @db.VarChar(66)
  headBlockTime    DateTime @db.Timestamptz(6)
  // Number of blocks behind a reorg triggers rollback (Base finality ~ minutes).
  safeDepth        Int      @default(64)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@map("chain_cursors")
}

model BlockReceipt {
  chainId       Int
  blockNumber   BigInt
  blockHash     String   @db.VarChar(66)
  blockTime     DateTime @db.Timestamptz(6)
  parentHash    String   @db.VarChar(66)
  transactionCount Int
  // Projection monotonic version stamped on rows written while this block was head.
  version       BigInt
  ingestedAt    DateTime @default(now()) @db.Timestamptz(6)

  @@id([chainId, blockNumber])
  @@map("block_receipts")
}

model RawChainEvent {
  chainId         Int
  blockNumber     BigInt
  logIndex        Int
  transactionIndex Int
  transactionHash String         @db.VarChar(66)
  address         String         @db.VarChar(42)
  topic0          String         @db.VarChar(66)
  topics          String[]       @db.VarChar(66)
  data            String         @db.VarChar(8192)
  eventName       String?        @db.VarChar(64)
  blockHash       String         @db.VarChar(66)
  blockTime       DateTime       @db.Timestamptz(6)

  @@id([chainId, blockNumber, logIndex])
  @@index([address, topic0, blockNumber])
  @@index([chainId, blockNumber(sort: Desc), logIndex(sort: Desc)])
  @@map("raw_chain_events")
}

// ---------------------------------------------------------------------------
// Onchain projections (indexer-owned, watermark-gated reads)
// ---------------------------------------------------------------------------

model ChainWatermark {
  chainId          Int      @id
  committedVersion BigInt
  blockNumber      BigInt
  blockHash        String   @db.VarChar(66)
  blockTime        DateTime @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@map("chain_watermarks")
}

model EconomicConfigRecord {
  chainId               Int      @id
  version               BigInt
  harvestServiceFeeWad  Decimal  @db.Decimal(38, 18)
  quoteCreatorShareWad  Decimal  @db.Decimal(38, 18)
  tokenMilestoneFundShareWad Decimal @db.Decimal(38, 18)
  activatedAtBlock      BigInt
  blockTime             DateTime @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  @@map("economic_config_records")
}

model PluginRegistryEntry {
  chainId    Int
  index      Int
  plugin     String   @db.VarChar(42)
  takeWad    Decimal  @db.Decimal(38, 18)
  gasLimit   Int
  codeHash   String   @db.VarChar(66)
  role       Int
  suspended  Boolean  @default(false)
  registeredAtBlock BigInt
  blockTime  DateTime @db.Timestamptz(6)

  @@id([chainId, index])
  @@index([chainId, plugin])
  @@map("plugin_registry_entries")
}

model GovernanceOperation {
  chainId      Int
  operationId  String            @db.VarChar(66)
  action       GovernanceAction
  payload      Json
  status       GovernanceStatus  @default(SCHEDULED)
  readyAtBlock BigInt?
  readyAt      DateTime?         @db.Timestamptz(6)
  executedAtBlock BigInt?
  cancelledAtBlock BigInt?
  blockTime    DateTime          @db.Timestamptz(6)

  @@id([chainId, operationId])
  @@index([chainId, status])
  @@map("governance_operations")
}

model TokenChainState {
  tokenId                  String       @id @db.Uuid
  chainId                  Int
  phase                    OnchainPhase
  contractAddress          String       @db.VarChar(42)
  poolId                   String       @db.VarChar(66)
  launchCreatorWallet      String       @db.VarChar(42)
  creatorRevenueNftId      Decimal?     @db.Decimal(78, 0)
  creatorRevenueOwner      String?      @db.VarChar(42)
  revenueNftMintedAt       DateTime?    @db.Timestamptz(6)
  launchedAt               DateTime     @db.Timestamptz(6)
  graduatedAt              DateTime?    @db.Timestamptz(6)
  totalSupply              Decimal      @db.Decimal(78, 0)
  currentSupply            Decimal      @db.Decimal(78, 0)
  decimals                 Int
  openingLevel             Int
  farLevel                 Int
  graduationLevel          Int?
  payoutPlan               Decimal      @db.Decimal(78, 0)
  devBuyShareWad           Decimal      @db.Decimal(38, 18)
  configHash               String      @db.VarChar(66)
  curveSupplyShareBps      Int          @default(2500)
  ladderSupplyShareBps     Int          @default(6500)
  fullRangeSupplyShareBps  Int          @default(1000)
  curvePositions           Int          @default(32)
  curveDeployed            Int          @default(0)
  coreBandCount            Int          @default(30)
  maxFeeFundedBands        Int          @default(30)
  deployedBands            Decimal      @default(0) @db.Decimal(78, 0)
  completedBands           Decimal      @default(0) @db.Decimal(78, 0)
  completedMilestones       Int          @default(0)
  completedExtensionMilestones Int      @default(0)
  feeFundedBandsCreated    Int          @default(0)
  bandLevelSpacing         Int          @default(2235)
  bandWidthLevels          Int          @default(447)
  carriedInventory         Decimal      @default(0) @db.Decimal(78, 0)
  milestoneFundAccrued     Decimal      @default(0) @db.Decimal(78, 0)
  payoutPot                Decimal      @default(0) @db.Decimal(78, 0)
  payoutPotFundedCount     Int          @default(0)
  directCreatorClaimable   Decimal      @default(0) @db.Decimal(78, 0)
  creatorPathClaimable     Decimal      @default(0) @db.Decimal(78, 0)
  pluginCarryBitmap        Decimal      @default(0) @db.Decimal(78, 0)
  lastPriceLevel           Int?
  lastSqrtPriceX96         Decimal?     @db.Decimal(78, 0)
  projectionVersion        BigInt
  sourceBlockNumber        BigInt
  sourceBlockHash          String      @db.VarChar(66)
  sourceBlockTime          DateTime    @db.Timestamptz(6)
  updatedAt                DateTime    @updatedAt @db.Timestamptz(6)
  token                    Token       @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([chainId, contractAddress])
  @@unique([chainId, poolId])
  @@index([phase, sourceBlockTime])
  @@index([chainId, launchCreatorWallet])
  @@map("token_chain_states")
}

model TokenMetric {
  tokenId           String    @db.Uuid
  chainId           Int
  timeframe         Timeframe
  priceEth          Decimal?  @db.Decimal(100, 36)
  priceUsd          Decimal?  @db.Decimal(100, 36)
  marketCapEth      Decimal?  @db.Decimal(100, 36)
  marketCapUsd      Decimal?  @db.Decimal(100, 36)
  volumeEth         Decimal?  @db.Decimal(100, 36)
  volumeUsd         Decimal?  @db.Decimal(100, 36)
  priceChangePct    Decimal?  @db.Decimal(38, 18)
  tradeCount        BigInt?
  holderCount       BigInt?
  projectionVersion BigInt
  sourceBlockNumber BigInt
  sourceBlockTime   DateTime  @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  token             Token     @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([tokenId, chainId, timeframe])
  @@index([timeframe, volumeUsd(sort: Desc)])
  @@index([timeframe, marketCapUsd(sort: Desc)])
  @@map("token_metrics")
}

model Trade {
  chainId           Int
  transactionHash   String    @db.VarChar(66)
  logIndex          Int
  transactionIndex  Int
  tokenId           String    @db.Uuid
  side              TradeSide
  traderWallet      String    @db.VarChar(42)
  tokenAmountRaw    Decimal   @db.Decimal(78, 0)
  quoteAmountRaw    Decimal   @db.Decimal(78, 0)
  priceLevel        Int
  sqrtPriceX96      Decimal   @db.Decimal(78, 0)
  priceUsd          Decimal?  @db.Decimal(100, 36)
  valueUsd          Decimal?  @db.Decimal(100, 36)
  lpFee             Int
  blockNumber       BigInt
  blockHash         String    @db.VarChar(66)
  blockTime         DateTime  @db.Timestamptz(6)
  projectionVersion BigInt
  token             Token     @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([chainId, transactionHash, logIndex])
  @@index([tokenId, chainId, blockNumber(sort: Desc), transactionIndex(sort: Desc), logIndex(sort: Desc)])
  @@index([tokenId, chainId, tokenAmountRaw(sort: Desc)])
  @@map("trades")
}

model Candle {
  tokenId           String         @db.Uuid
  chainId           Int
  interval          CandleInterval
  bucketStart       DateTime       @db.Timestamptz(6)
  open              Decimal        @db.Decimal(100, 36)
  high              Decimal        @db.Decimal(100, 36)
  low               Decimal        @db.Decimal(100, 36)
  close             Decimal        @db.Decimal(100, 36)
  volumeEth         Decimal        @db.Decimal(100, 36)
  volumeUsd         Decimal?       @db.Decimal(100, 36)
  tradeCount        BigInt
  projectionVersion BigInt
  token             Token          @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([tokenId, chainId, interval, bucketStart])
  @@map("candles")
}

model Milestone {
  tokenId            String         @db.Uuid
  chainId            Int
  kind               MilestoneKind
  index              Int
  state              MilestoneState
  levelLower         Int
  levelUpper         Int
  liquidity          Decimal?       @db.Decimal(78, 0)
  tokenInventoryRaw  Decimal        @db.Decimal(78, 0)
  tokenRemainingRaw  Decimal        @default(0) @db.Decimal(78, 0)
  quoteProceedsRaw   Decimal        @default(0) @db.Decimal(78, 0)
  grossHarvestRaw    Decimal        @default(0) @db.Decimal(78, 0)
  serviceFeeRaw      Decimal        @default(0) @db.Decimal(78, 0)
  netPotRaw          Decimal        @default(0) @db.Decimal(78, 0)
  economicVersion    BigInt?
  harvestedAt        DateTime?      @db.Timestamptz(6)
  deployedAt         DateTime?      @db.Timestamptz(6)
  skippedAt          DateTime?      @db.Timestamptz(6)
  projectionVersion  BigInt
  sourceBlockNumber  BigInt
  sourceBlockTime    DateTime       @db.Timestamptz(6)
  token              Token          @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([tokenId, chainId, kind, index])
  @@index([tokenId, chainId, state, kind, index])
  @@map("milestones")
}

model Holding {
  walletAddress     String   @db.VarChar(42)
  tokenId           String   @db.Uuid
  chainId           Int
  balanceRaw        Decimal  @db.Decimal(78, 0)
  valueUsd          Decimal? @db.Decimal(100, 36)
  lastActivityAt    DateTime @db.Timestamptz(6)
  projectionVersion BigInt
  sourceBlockNumber BigInt
  sourceBlockTime   DateTime @db.Timestamptz(6)
  token             Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([walletAddress, tokenId, chainId])
  @@index([walletAddress, valueUsd(sort: Desc)])
  @@index([walletAddress, lastActivityAt(sort: Desc)])
  @@map("holdings")
}

model RevenueEvent {
  id                String          @id @default(uuid()) @db.Uuid
  chainId           Int
  tokenId           String?         @db.Uuid
  poolId            String          @db.VarChar(66)
  milestoneIndex    Int?
  kind              String          @db.VarChar(48)
  outcome           PayoutOutcome?
  source            AccrualSource?
  economicVersion   BigInt?
  walletAddress     String?         @db.VarChar(42)
  pluginIndex       Int?
  amountRaw         Decimal         @db.Decimal(78, 0)
  carriedAmountRaw  Decimal         @default(0) @db.Decimal(78, 0)
  transactionHash   String          @db.VarChar(66)
  logIndex          Int
  blockNumber       BigInt
  blockTime         DateTime        @db.Timestamptz(6)
  token             Token?          @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([chainId, transactionHash, logIndex])
  @@index([tokenId, chainId, blockNumber, logIndex])
  @@index([poolId, kind, blockNumber])
  @@index([walletAddress, blockNumber(sort: Desc)])
  @@map("revenue_events")
}

// ---------------------------------------------------------------------------
// Social (API-owned)
// ---------------------------------------------------------------------------

model Comment {
  id            String        @id @default(uuid()) @db.Uuid
  tokenId       String        @db.Uuid
  walletAddress String        @db.VarChar(42)
  parentId      String?       @db.Uuid
  rootId        String        @db.Uuid
  depth         Int
  text          String?       @db.VarChar(8000)
  isDeleted     Boolean       @default(false)
  likeCount     Int           @default(0)
  replyCount    Int           @default(0)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?     @db.Timestamptz(6)
  token         Token         @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  author        Profile       @relation(fields: [walletAddress], references: [walletAddress])
  parent        Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies       Comment[]     @relation("CommentReplies")
  likes         CommentLike[]

  @@unique([id, tokenId])
  @@index([tokenId, parentId, createdAt])
  @@index([tokenId, rootId, createdAt])
  @@index([tokenId, parentId, likeCount(sort: Desc), createdAt(sort: Desc)])
  @@map("comments")
}

model CommentLike {
  commentId     String   @db.Uuid
  walletAddress String   @db.VarChar(42)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  comment       Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile       Profile  @relation(fields: [walletAddress], references: [walletAddress])

  @@id([commentId, walletAddress])
  @@map("comment_likes")
}
