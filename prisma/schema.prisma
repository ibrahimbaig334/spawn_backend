generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Enums
// ===========================================================================

enum Timeframe {
  H1
  H24
  D7
  D30
  ALL
}

enum PoolStatus {
  bonding
  graduated
}

enum BandStatus {
  live
  completed
}

enum PluginRole {
  INVALID
  PAYOUT
  CREATOR_SYSTEM
  UTILITY
}

enum AccrualSource {
  CURVE_PROCEEDS
  SWAP_FEES
  MILESTONE_HARVEST
}

enum PayoutOutcome {
  delivered
  carried
  redirected
}

enum ClaimType {
  creator
  creatorPath
  protocol
}

enum GovernanceAction {
  SET_ECONOMIC_CONFIG
  SET_PROTOCOL_RECIPIENT
  REGISTER_PLUGIN
  SET_PLUGIN_SUSPENDED
  SET_GOVERNANCE_DELAY
  SET_TRUSTED_OPERATOR
}

enum GovernanceStatus {
  SCHEDULED
  CANCELLED
  EXECUTED
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum LaunchRecordState {
  PENDING_RELAY
  SUBMITTED
  CONFIRMED
  REORGED
  FAILED
}

enum TokenSource {
  API
  INDEXER
}

// ===========================================================================
// API-owned tables
// ===========================================================================

model Profile {
  walletAddress  String      @id @db.VarChar(42)
  username       String?     @unique @db.VarChar(32)
  usernameFolded String?     @unique @db.VarChar(32)
  bio            String?     @db.VarChar(1200)
  imageUri       String?     @db.VarChar(512)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  tokens         Token[]
  comments       Comment[]
  commentLikes   CommentLike[]

  @@map("profiles")
}

// The state table `tokens` per the backend guide (ERC-20 metadata from Launched)
// extended with the offchain registration fields the API owns.
model Token {
  id                   String      @id @default(uuid()) @db.Uuid
  chainId              Int         @default(8453) @map("chain_id")
  token                String?     @db.VarChar(42)
  name                 String      @db.VarChar(320)
  symbol               String      @db.VarChar(12)
  uri                  String      @default("") @db.VarChar(2048)
  description          String?     @db.VarChar(8000)
  imageUri             String?     @db.VarChar(512)
  ipfsUri              String?     @db.VarChar(512)
  gatewayUrl           String?     @db.VarChar(2048)
  socials              Json?
  claimedCreatorWallet String?     @db.VarChar(42)
  source               TokenSource @default(INDEXER)
  createdAt            DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(6)
  creator              Profile?    @relation(fields: [claimedCreatorWallet], references: [walletAddress])
  pool                 Pool?
  launchRecord         LaunchRecord?
  comments             Comment[]

  @@unique([chainId, token])
  @@index([claimedCreatorWallet, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("tokens")
}

model LaunchRecord {
  id              String            @id @default(uuid()) @db.Uuid
  chainId         Int
  creatorWallet   String            @db.VarChar(42)
  name            String            @db.VarChar(320)
  symbol          String            @db.VarChar(12)
  uri             String            @db.VarChar(2048)
  description     String            @db.VarChar(8000)
  imageUri        String            @db.VarChar(512)
  ipfsUri         String?           @db.VarChar(512)
  gatewayUrl      String?           @db.VarChar(2048)
  socials         Json?
  totalSupply     Decimal           @db.Decimal(78, 0)
  devBuyShareWad  Decimal           @db.Decimal(38, 18)
  payoutPlan      Decimal           @db.Decimal(78, 0)
  deadline        BigInt
  configHash      String            @db.VarChar(66)
  predictedToken  String            @db.VarChar(42)
  digest          String            @db.VarChar(66)
  state           LaunchRecordState @default(PENDING_RELAY)
  transactionHash String?           @db.VarChar(66)
  blockNumber     BigInt?
  submittedAt     DateTime?         @db.Timestamptz(6)
  confirmedAt     DateTime?         @db.Timestamptz(6)
  failureReason   String?           @db.VarChar(1000)
  tokenDbId       String?           @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  token           Token?            @relation(fields: [tokenDbId], references: [id])

  @@unique([chainId, configHash, creatorWallet])
  @@unique([tokenDbId])
  @@index([creatorWallet, state])
  @@index([state, createdAt])
  @@map("launch_records")
}

model IdempotencyRequest {
  id             String           @id @default(uuid()) @db.Uuid
  scope          String           @db.VarChar(128)
  walletAddress  String           @db.VarChar(42)
  key            String           @db.VarChar(128)
  requestHash    String           @db.VarChar(66)
  state          IdempotencyState @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  resourceId     String?          @db.Uuid
  expiresAt      DateTime         @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([scope, walletAddress, key])
  @@index([expiresAt])
  @@map("idempotency_requests")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  topic          String    @db.VarChar(128)
  aggregateId    String    @db.VarChar(128)
  attemptVersion Int?
  payload        Json
  availableAt    DateTime  @default(now()) @db.Timestamptz(6)
  leaseOwner     String?   @db.VarChar(128)
  leaseExpiresAt DateTime? @db.Timestamptz(6)
  publishedAt    DateTime? @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

model DomainGeneration {
  domain     String   @id @db.VarChar(128)
  generation BigInt   @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@map("domain_generations")
}

model Comment {
  id            String        @id @default(uuid()) @db.Uuid
  tokenDbId     String        @db.Uuid
  walletAddress String        @db.VarChar(42)
  parentId      String?       @db.Uuid
  rootId        String        @db.Uuid
  depth         Int
  text          String?       @db.VarChar(8000)
  isDeleted     Boolean       @default(false)
  likeCount     Int           @default(0)
  replyCount    Int           @default(0)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?     @db.Timestamptz(6)
  token         Token         @relation(fields: [tokenDbId], references: [id], onDelete: Cascade)
  author        Profile       @relation(fields: [walletAddress], references: [walletAddress])
  parent        Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies       Comment[]     @relation("CommentReplies")
  likes         CommentLike[]

  @@unique([id, tokenDbId])
  @@index([tokenDbId, parentId, createdAt])
  @@index([tokenDbId, rootId, createdAt])
  @@index([tokenDbId, parentId, likeCount(sort: Desc), createdAt(sort: Desc)])
  @@map("comments")
}

model CommentLike {
  commentId     String   @db.Uuid
  walletAddress String   @db.VarChar(42)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  comment       Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile       Profile  @relation(fields: [walletAddress], references: [walletAddress])

  @@id([commentId, walletAddress])
  @@map("comment_likes")
}

// ===========================================================================
// Indexer infrastructure (API-owned read cut + reorg ledger)
// ===========================================================================

model DeploymentManifest {
  chainId   Int      @id
  document  Json
  syncedAt  DateTime @updatedAt @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("deployment_manifests")
}

model ChainCursor {
  chainId       Int      @id
  nextBlock     BigInt
  headBlock     BigInt
  headBlockHash String   @db.VarChar(66)
  headBlockTime DateTime @db.Timestamptz(6)
  safeDepth     Int      @default(64)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@map("chain_cursors")
}

model ChainWatermark {
  chainId          Int      @id
  committedVersion BigInt
  blockNumber      BigInt
  blockHash        String   @db.VarChar(66)
  blockTime        DateTime @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@map("chain_watermarks")
}

model BlockReceipt {
  chainId          Int
  blockNumber      BigInt
  blockHash        String   @db.VarChar(66)
  blockTime        DateTime @db.Timestamptz(6)
  parentHash       String   @db.VarChar(66)
  transactionCount Int
  version          BigInt
  ingestedAt       DateTime @default(now()) @db.Timestamptz(6)

  @@id([chainId, blockNumber])
  @@map("block_receipts")
}

model RawChainEvent {
  chainId          Int      @map("chain_id")
  blockNumber      BigInt   @map("block_number")
  logIndex         Int      @map("log_index")
  transactionIndex Int      @map("transaction_index")
  transactionHash  String   @map("tx_hash") @db.VarChar(66)
  address          String   @db.VarChar(42)
  topic0           String   @db.VarChar(66)
  topics           String[] @db.VarChar(66)
  data             String   @db.VarChar(8192)
  eventName        String?  @map("event_name") @db.VarChar(64)
  blockHash        String   @map("block_hash") @db.VarChar(66)
  blockTime        DateTime @map("timestamp") @db.Timestamptz(6)

  @@id([chainId, blockNumber, logIndex])
  @@index([address, topic0, blockNumber])
  @@index([chainId, blockNumber(sort: Desc), logIndex(sort: Desc)])
  @@map("raw_chain_events")
}

// ===========================================================================
// State tables (upserted, last write wins) — per backend guide §2.1
// ===========================================================================

model Pool {
  chainId         Int        @default(8453) @map("chain_id")
  poolId          String     @map("pool_id") @db.VarChar(66)
  status          PoolStatus @default(bonding)
  token           String     @db.VarChar(42)
  creator         String     @db.VarChar(42)
  totalSupply     Decimal    @map("total_supply") @db.Decimal(78, 0)
  openingLevel    Int        @map("opening_level")
  farLevel        Int        @map("far_level")
  graduationLevel Int?       @map("graduation_level")
  payoutPlan      Decimal    @map("payout_plan") @db.Decimal(78, 0)
  devBuyShareWad  Decimal    @map("dev_buy_share_wad") @db.Decimal(38, 18)
  configHash      String     @map("config_hash") @db.VarChar(66)
  wallLiquidity   Decimal?   @map("wall_liquidity") @db.Decimal(78, 0)
  fullRangeLiq    Decimal?   @map("wall_full_range_liquidity") @db.Decimal(78, 0)
  revenueNftOwner String?    @map("revenue_nft_owner") @db.VarChar(42)
  revenueNftId    Decimal?   @map("revenue_nft_token_id") @db.Decimal(78, 0)
  launchBlock     BigInt     @map("launch_block")
  launchTime      DateTime   @map("launch_time") @db.Timestamptz(6)
  graduationBlock BigInt?    @map("graduation_block")
  graduationTime  DateTime?  @map("graduation_time") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)
  tokenRecord     Token?     @relation(fields: [chainId, token], references: [chainId, token])
  tokenDbId       String?    @db.Uuid
  stats           PoolStats?
  bands           Band[]
  pot             Pot?

  @@id([chainId, poolId])
  @@unique([chainId, token])
  @@index([status, launchTime(sort: Desc)])
  @@index([creator])
  @@map("pools")
}

model Band {
  chainId       Int          @default(8453) @map("chain_id")
  poolId        String       @map("pool_id") @db.VarChar(66)
  bandIndex     Int          @map("band_index")
  status        BandStatus   @default(live)
  levelLower    Int          @map("level_lower")
  levelUpper    Int          @map("level_upper")
  liquidity     Decimal      @db.Decimal(78, 0)
  tokenInventory Decimal     @map("token_inventory") @db.Decimal(78, 0)
  deployedBlock BigInt       @map("deployed_block")
  deployedAt    DateTime     @map("deployed_time") @db.Timestamptz(6)
  completedBlock BigInt?     @map("completed_block")
  completedAt   DateTime?    @map("completed_time") @db.Timestamptz(6)
  pool          Pool         @relation(fields: [chainId, poolId], references: [chainId, poolId], onDelete: Cascade)

  @@id([chainId, poolId, bandIndex])
  @@index([chainId, poolId, status])
  @@map("bands")
}

model Pot {
  chainId         Int     @default(8453) @map("chain_id")
  poolId          String  @map("pool_id") @db.VarChar(66)
  balance         Decimal @db.Decimal(78, 0) @default(0)
  fundedTotal     Decimal @map("funded_total") @db.Decimal(78, 0) @default(0)
  serviceFeeTotal Decimal @map("service_fee_total") @db.Decimal(78, 0) @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  pool            Pool    @relation(fields: [chainId, poolId], references: [chainId, poolId], onDelete: Cascade)

  @@id([chainId, poolId])
  @@map("pots")
}

model PluginRegistryEntry {
  chainId         Int        @default(8453) @map("chain_id")
  registryIndex   Int        @map("registry_index")
  plugin          String     @db.VarChar(42)
  takeWad         Decimal    @map("take_wad") @db.Decimal(38, 18)
  gasLimit        Int        @map("gas_limit")
  codeHash        String     @map("code_hash") @db.VarChar(66)
  role            PluginRole
  suspended       Boolean    @default(false)
  registeredBlock BigInt     @map("registered_block")
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  @@id([chainId, registryIndex])
  @@unique([chainId, plugin])
  @@map("plugin_registry")
}

model EconomicConfig {
  chainId                    Int      @default(8453) @map("chain_id")
  version                    BigInt
  harvestServiceFeeWad       Decimal  @map("harvest_service_fee_wad") @db.Decimal(38, 18)
  quoteCreatorShareWad       Decimal  @map("quote_creator_share_wad") @db.Decimal(38, 18)
  tokenMilestoneFundShareWad Decimal  @map("token_milestone_fund_share_wad") @db.Decimal(38, 18)
  effectiveBlock             BigInt   @map("effective_block")
  effectiveAt                DateTime @map("effective_time") @db.Timestamptz(6)

  @@id([chainId, version])
  @@map("economic_configs")
}

model ProtocolState {
  chainId                Int      @default(8453) @map("chain_id") @id
  economicVersion        BigInt   @map("economic_version") @default(1)
  protocolRecipient      String?  @map("protocol_recipient") @db.VarChar(42)
  trustedOperator        String?  @map("trusted_operator") @db.VarChar(42)
  trustedOperatorBlock   BigInt?  @map("trusted_operator_set_block")
  administrator          String?  @db.VarChar(42)
  pendingAdministrator   String?  @map("pending_administrator") @db.VarChar(42)
  governanceDelaySeconds BigInt?  @map("governance_delay_seconds")
  lastIndexedBlock       BigInt   @map("last_indexed_block") @default(0)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  @@map("protocol_state")
}

model GovernanceOperation {
  chainId          Int               @default(8453) @map("chain_id")
  operationId      String            @map("operation_id") @db.VarChar(66)
  action           GovernanceAction
  payload          Json
  status           GovernanceStatus  @default(SCHEDULED)
  readyAt          DateTime?         @map("ready_at") @db.Timestamptz(6)
  executedAtBlock  BigInt?           @map("executed_at_block")
  cancelledAtBlock BigInt?           @map("cancelled_at_block")
  blockTime        DateTime          @map("timestamp") @db.Timestamptz(6)

  @@id([chainId, operationId])
  @@index([chainId, status])
  @@map("governance_operations")
}

// ===========================================================================
// Aggregate tables (sink delta-ops only) — per backend guide §2.2
// ===========================================================================

model PoolStats {
  chainId                  Int      @default(8453) @map("chain_id")
  poolId                   String   @map("pool_id") @db.VarChar(66)
  buyVolumeEth             Decimal  @default(0) @map("buy_volume_eth") @db.Decimal(78, 0)
  sellVolumeEth            Decimal  @default(0) @map("sell_volume_eth") @db.Decimal(78, 0)
  buyVolumeTokens          Decimal  @default(0) @map("buy_volume_tokens") @db.Decimal(78, 0)
  sellVolumeTokens         Decimal  @default(0) @map("sell_volume_tokens") @db.Decimal(78, 0)
  swapCount                BigInt   @default(0) @map("swap_count")
  lastPriceSqrtX96         Decimal  @map("last_price_sqrt_x96") @db.Decimal(78, 0)
  athSqrtX96               Decimal  @default(0) @map("ath_sqrt_x96") @db.Decimal(78, 0)
  creatorRevenueTotal      Decimal  @default(0) @map("creator_revenue_total") @db.Decimal(78, 0)
  creatorRevenueCurve      Decimal  @default(0) @map("creator_revenue_curve") @db.Decimal(78, 0)
  creatorRevenueSwapFees   Decimal  @default(0) @map("creator_revenue_swap_fees") @db.Decimal(78, 0)
  protocolRevenueTotal     Decimal  @default(0) @map("protocol_revenue_total") @db.Decimal(78, 0)
  protocolRevenueCurve     Decimal  @default(0) @map("protocol_revenue_curve") @db.Decimal(78, 0)
  protocolRevenueSwapFees  Decimal  @default(0) @map("protocol_revenue_swap_fees") @db.Decimal(78, 0)
  protocolRevenueHarvest   Decimal  @default(0) @map("protocol_revenue_harvest_fees") @db.Decimal(78, 0)
  creatorPathRevenueTotal  Decimal  @default(0) @map("creator_path_revenue_total") @db.Decimal(78, 0)
  pluginRevenueTotal       Decimal  @default(0) @map("plugin_revenue_total") @db.Decimal(78, 0)
  potFundedTotal           Decimal  @default(0) @map("pot_funded_total") @db.Decimal(78, 0)
  tipsTotal                Decimal  @default(0) @map("tips_total") @db.Decimal(78, 0)
  bandsDeployed            Int      @default(0) @map("bands_deployed")
  harvestCount             Int      @default(0) @map("harvest_count")
  harvestQuoteTotal        Decimal  @default(0) @map("harvest_quote_total") @db.Decimal(78, 0)
  swapFeeBurnedTokens      Decimal  @default(0) @map("swap_fee_burned_tokens") @db.Decimal(78, 0)
  burnedTotal              Decimal  @default(0) @map("burned_total") @db.Decimal(78, 0)
  lastSwapBlock            BigInt   @default(0) @map("last_swap_block")
  updatedAt                DateTime @updatedAt @db.Timestamptz(6)
  pool                     Pool     @relation(fields: [chainId, poolId], references: [chainId, poolId], onDelete: Cascade)

  @@id([chainId, poolId])
  @@map("pool_stats")
}

model PoolMinuteStats {
  chainId          BigInt   @default(8453) @map("chain_id")
  poolId           String   @map("pool_id") @db.VarChar(66)
  minute           DateTime @db.Timestamptz(6)
  openSqrtX96      Decimal  @map("open_sqrt_x96") @db.Decimal(78, 0)
  closeSqrtX96     Decimal  @map("close_sqrt_x96") @db.Decimal(78, 0)
  highSqrtX96      Decimal  @map("high_sqrt_x96") @db.Decimal(78, 0)
  lowSqrtX96       Decimal  @map("low_sqrt_x96") @db.Decimal(78, 0)
  buyVolumeEth     Decimal  @default(0) @map("buy_volume_eth") @db.Decimal(78, 0)
  sellVolumeEth    Decimal  @default(0) @map("sell_volume_eth") @db.Decimal(78, 0)
  buyVolumeTokens  Decimal  @default(0) @map("buy_volume_tokens") @db.Decimal(78, 0)
  sellVolumeTokens Decimal  @default(0) @map("sell_volume_tokens") @db.Decimal(78, 0)
  swapCount        BigInt   @default(0) @map("swap_count")
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@id([chainId, poolId, minute])
  @@index([poolId, minute(sort: Desc)])
  @@map("pool_minute_stats")
}

model PoolHourStats {
  chainId          BigInt   @default(8453) @map("chain_id")
  poolId           String   @map("pool_id") @db.VarChar(66)
  hour             DateTime @db.Timestamptz(6)
  openSqrtX96      Decimal  @map("open_sqrt_x96") @db.Decimal(78, 0)
  closeSqrtX96     Decimal  @map("close_sqrt_x96") @db.Decimal(78, 0)
  highSqrtX96      Decimal  @map("high_sqrt_x96") @db.Decimal(78, 0)
  lowSqrtX96       Decimal  @map("low_sqrt_x96") @db.Decimal(78, 0)
  buyVolumeEth     Decimal  @default(0) @map("buy_volume_eth") @db.Decimal(78, 0)
  sellVolumeEth    Decimal  @default(0) @map("sell_volume_eth") @db.Decimal(78, 0)
  buyVolumeTokens  Decimal  @default(0) @map("buy_volume_tokens") @db.Decimal(78, 0)
  sellVolumeTokens Decimal  @default(0) @map("sell_volume_tokens") @db.Decimal(78, 0)
  swapCount        BigInt   @default(0) @map("swap_count")
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@id([chainId, poolId, hour])
  @@index([poolId, hour(sort: Desc)])
  @@map("pool_hour_stats")
}

model PoolDayStats {
  chainId           BigInt   @default(8453) @map("chain_id")
  poolId            String   @map("pool_id") @db.VarChar(66)
  day               DateTime @db.Timestamptz(6)
  openSqrtX96       Decimal  @map("open_sqrt_x96") @db.Decimal(78, 0)
  closeSqrtX96      Decimal  @map("close_sqrt_x96") @db.Decimal(78, 0)
  highSqrtX96       Decimal  @map("high_sqrt_x96") @db.Decimal(78, 0)
  lowSqrtX96        Decimal  @map("low_sqrt_x96") @db.Decimal(78, 0)
  buyVolumeEth      Decimal  @default(0) @map("buy_volume_eth") @db.Decimal(78, 0)
  sellVolumeEth     Decimal  @default(0) @map("sell_volume_eth") @db.Decimal(78, 0)
  buyVolumeTokens   Decimal  @default(0) @map("buy_volume_tokens") @db.Decimal(78, 0)
  sellVolumeTokens  Decimal  @default(0) @map("sell_volume_tokens") @db.Decimal(78, 0)
  swapCount         BigInt   @default(0) @map("swap_count")
  creatorRevenueEth Decimal  @default(0) @map("creator_revenue_eth") @db.Decimal(78, 0)
  protocolRevenueEth Decimal @default(0) @map("protocol_revenue_eth") @db.Decimal(78, 0)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@id([chainId, poolId, day])
  @@index([poolId, day(sort: Desc)])
  @@map("pool_day_stats")
}

model ProtocolDayStats {
  chainId            BigInt   @default(8453) @map("chain_id")
  day                DateTime @db.Timestamptz(6)
  buyVolumeEth       Decimal  @default(0) @map("buy_volume_eth") @db.Decimal(78, 0)
  sellVolumeEth      Decimal  @default(0) @map("sell_volume_eth") @db.Decimal(78, 0)
  swapCount          BigInt   @default(0) @map("swap_count")
  creatorRevenueEth  Decimal  @default(0) @map("creator_revenue_eth") @db.Decimal(78, 0)
  protocolRevenueEth Decimal  @default(0) @map("protocol_revenue_eth") @db.Decimal(78, 0)
  harvestFeesEth     Decimal  @default(0) @map("harvest_fees_eth") @db.Decimal(78, 0)
  graduationCount    Int      @default(0) @map("graduation_count")
  launchCount        Int      @default(0) @map("launch_count")
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  @@id([chainId, day])
  @@map("protocol_day_stats")
}

model ProtocolStats {
  chainId                BigInt   @default(8453) @map("chain_id") @id
  protocolRevenueCurve   Decimal  @default(0) @map("protocol_revenue_curve") @db.Decimal(78, 0)
  protocolRevenueSwapFees Decimal @default(0) @map("protocol_revenue_swap_fees") @db.Decimal(78, 0)
